<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Headless Undertone: the OpenSubsonic server, library scanner and device sync
         from Undertone.Core, hosted as a console app for a NAS, a VPS or Docker. No
         Avalonia, no LibVLC, no Whisper: any Subsonic client (Symfonium, substreamer,
         Feishin, Amperfy, ...) browses, searches, streams, stars and scrobbles. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Undertone.Server</RootNamespace>
    <AssemblyName>undertone-server</AssemblyName>
    <Version>1.5.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Undertone.Core\Undertone.Core.csproj" />
    <ProjectReference Include="..\Undertone.Core.Server\Undertone.Core.Server.csproj" />
  </ItemGroup>

</Project>
